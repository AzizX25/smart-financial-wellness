# Synthetic sample identity. Copy to .env.demo; never commit .env.demo.
DEMO_SCENARIO_VERSION=supervisor-demo-v1
DEMO_PLATFORM_EMAIL=amine.bensalem@example.test
DEMO_BANK_USERNAME=amine.bensalem.demo
DEMO_FULL_NAME=Amine Ben Salem
DEMO_CURRENCY=TND
DEMO_LANGUAGE_TAG=fr-TN
DEMO_TIME_ZONE=Africa/Tunis
DEMO_COUNTRY_CODE=TN

# Private values belong only in the ignored .env.demo file.
DEMO_PLATFORM_PASSWORD=
DEMO_BANK_PASSWORD=
# Choose the local administrator password below on the first run.
# Existing administrators are never overwritten; a mismatch stops startup safely.
DEMO_MOCK_BANK_ADMIN_USERNAME=local.demo.admin
DEMO_MOCK_BANK_ADMIN_PASSWORD=

DEMO_PLATFORM_URL=http://localhost:8080
DEMO_MOCK_BANK_URL=http://localhost:8081
DEMO_MAILPIT_URL=http://localhost:8025

# Enables the administrator-protected mock-bank fixture endpoints in local Compose.
MOCK_BANK_SPRING_PROFILES_ACTIVE=demo
SUPERVISOR_DEMO_ENABLED=true
MOCK_BANK_ADMIN_BOOTSTRAP_ENABLED=true

# Core seeding never needs Ollama or web search. Opt in explicitly afterward.
DEMO_RUN_MERCHANT_AI=false
