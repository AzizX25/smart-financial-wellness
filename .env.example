# Copy this file to .env and replace the password before starting PostgreSQL.
DB_NAME=smart_financial_wellness
DB_USERNAME=smart_financial_wellness
DB_PASSWORD=replace_with_a_local_password
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
FRONTEND_API_URL=http://localhost:8080

# Local-development placeholder only. Replace it outside source control.
AUTH_JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Mock-bank local database and application settings.
MOCK_BANK_DB_NAME=mock_bank
MOCK_BANK_DB_USERNAME=mock_bank
MOCK_BANK_DB_PASSWORD=replace_with_a_local_mock_bank_password
MOCK_BANK_PORT=8081

# Development-only mock-bank JWT settings. Replace the signing secret outside
# source control; it must decode from Base64 to at least 32 bytes.
MOCK_BANK_JWT_SECRET=YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODg5
MOCK_BANK_JWT_ISSUER=smart-financial-wellness-mock-bank
MOCK_BANK_JWT_AUDIENCE=smart-financial-wellness-backend
MOCK_BANK_ACCESS_TOKEN_TTL=10m
MOCK_BANK_ADMIN_ACCESS_TOKEN_TTL=15m
MOCK_BANK_ADMIN_UI_ORIGIN=http://localhost:5174
MOCK_BANK_ADMIN_API_URL=http://localhost:8081
MOCK_BANK_UI_PORT=5174

# Used when the backend runs on the host. Compose overrides the base URL with
# http://mock-bank:8081 so containers communicate over the internal network.
MOCK_BANK_BASE_URL=http://localhost:8081
MOCK_BANK_CONNECT_TIMEOUT=2s
MOCK_BANK_READ_TIMEOUT=5s

# Optional experimental Forecast inference service. Compose keeps this service
# internal and configures the backend URL automatically.
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_CONNECT_TIMEOUT=2s
AI_SERVICE_READ_TIMEOUT=5s
AI_FORECAST_EXPECTED_MODEL_ID=forecast-huber-synthetic-tnd
AI_FORECAST_EXPECTED_MODEL_VERSION=1.0.0
AI_FORECAST_EXPECTED_FEATURE_VERSION=forecast-residual-features-v1

# Optional host ports for the local Mailpit SMTP server and web interface.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
