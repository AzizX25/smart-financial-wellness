# Copy this file to .env and replace the password before starting PostgreSQL.
DB_NAME=smart_financial_wellness
DB_USERNAME=smart_financial_wellness
DB_PASSWORD=replace_with_a_local_password
DB_PORT=5432

# Mock-bank local database and application settings.
MOCK_BANK_DB_NAME=mock_bank
MOCK_BANK_DB_USERNAME=mock_bank
MOCK_BANK_DB_PASSWORD=replace_with_a_local_mock_bank_password
MOCK_BANK_PORT=8081

# Optional host ports for the local Mailpit SMTP server and web interface.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
